{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.mountable_slime": {
      "states": {
        "default": {
          "transitions": [
            {
              "mountable_slime": "q.has_rider"
            }
          ]
        },
        "mountable_slime": {
          "on_entry": [
            "@s default_slime"
          ],
          "transitions": [
            {
              "default": "1.0"
            }
          ]
        }
      }
    }
  }
}
