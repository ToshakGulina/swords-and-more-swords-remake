          "fuse_length": 0,
          "fuse_lit": true,
          "power": 1,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "effect:instant_despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:timer": {
        "time": [
          0.1,
          0.1
        ],
