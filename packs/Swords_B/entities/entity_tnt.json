            }
          },
          "impact_damage": {
            "damage": 1,
            "knockback": true,
            "destroy_on_hit": false
          },
          "particle_on_hit": {}
        },
        "hit_sound": "fuse",
        "power": 2,
        "gravity": 0,
        "angle_offset": 0
      },
      "minecraft:type_family": {
        "family": [
          "effect99_entities"
        ]
      },
      "minecraft:collision_box": {
        "width": 0,
        "height": 0
      },
      "minecraft:physics": {},
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "value": "effect99_entities"
                }
              ]
            },
            "event": "particle"
          }
        ]
      }
    },
    "events": {
      "mini_explosion": {
        "add": {
          "component_groups": [
            "mini_explosion"
          ]
        }
      },
      "despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      },
      "particle": {
        "queue_command": {
          "command": [
            "particle minecraft:obsidian_glow_dust_particle ~ ~ ~"
          ]
        }
      },
      "effect:instant_despawn": {
        "add": {
          "component_groups": [
            "effect:instant_despawn"
          ]
        }
      }
