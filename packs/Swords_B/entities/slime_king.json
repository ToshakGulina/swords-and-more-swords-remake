{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:slime_king",
      "runtime_identifier": "minecraft:slime",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:slime_large": {},
      "minecraft:slime_medium": {},
      "minecraft:slime_small": {},
      "health_bar": {
        "minecraft:boss": {
          "should_darken_sky": false,
          "name": "§l§aKing Slime",
          "hud_range": 32
        }
      },
      "despawn": {
        "minecraft:instant_despawn": {}
      },
      "effect:instant_despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 40"
      },
      "minecraft:type_family": {
        "family": [
          "slime",
          "monster",
          "mob",
          "slime_king"
        ]
      },
      "minecraft:attack": {
        "damage": 9
      },
      "minecraft:scale": {
        "value": 4.3
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:movement": {
        "value": 1.1
      },
      "minecraft:movement.jump": {
        "jump_delay": [
          0.16,
          0.4
        ]
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 300
      },
      "minecraft:knockback_resistance": {
        "value": 0.5
      },
      "minecraft:behavior.slime_float": {
        "priority": 1
      },
      "minecraft:behavior.slime_attack": {
        "priority": 3
      },
      "minecraft:behavior.slime_random_direction": {
        "priority": 4
      },
      "minecraft:behavior.slime_keep_on_jumping": {
        "priority": 5
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "snowgolem"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "irongolem"
                }
              ]
            },
            "max_dist": 38
          }
        ],
        "must_see": true
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "health_bar"
            },
            "deals_damage": true
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "subject": "self",
                    "value": "fall"
                  }
                ]
              },
              "event": "fall_damage"
            },
            "deals_damage": false
          }
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {},
            "event": "slime_effects"
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "minecraft:despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      },
      "health_bar": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "health_bar"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 95
              },
              {
                "weight": 5,
                "queue_command": {
                  "command": [
                    "effect @s jump_boost 1 15 true"
                  ]
                }
              }
            ]
          }
        ]
      },
      "fall_damage": {
        "queue_command": {
          "command": [
            "effect @e[r=3,family=!slime_king] instant_damage 1 1 true",
            "effect @e[r=4,type=iron_golem] instant_damage 1 2 true"
          ]
        }
      },
      "slime_effects": {
        "queue_command": {
          "command": [
            "effect @s jump_boost 1 0 true",
            "damage @p[r=1.8] 4 magic",
            "damage @e[r=1.5,family=!slime_king] 2 magic"
          ]
        }
      },
      "effect:instant_despawn": {
        "add": {
          "component_groups": [
            "effect:instant_despawn"
          ]
        }
      }
    }
  }
}
