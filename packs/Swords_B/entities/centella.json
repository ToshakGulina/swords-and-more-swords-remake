                    "value": "player"
                  }
                ]
              },
              "event": "centella_death_by_player"
            },
            "deals_damage": true
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "value": "fatal"
                  }
                ]
              },
              "event": "centella_death"
            },
            "deals_damage": true
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.22
      },
      "minecraft:loot": {
        "table": "loot_tables/empty.json"
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "can_path_over_lava": true,
        "can_walk_in_lava": true,
        "can_jump": false,
        "avoid_water": true,
