{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:ender_crystal",
      "is_experimental": false,
      "is_summonable": true,
      "is_spawnable": false,
      "spawn_category": "misc"
    },
    "components": {
      "minecraft:collision_box": {
        "height": 2,
        "width": 2
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:fire_immune": {},
      "minecraft:health": {
        "max": 1,
        "value": 1
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "component_groups": {
      "crystal_exploding": {
        "minecraft:explode": {
          "causes_fire": false,
          "fuse_lit": true,
          "power": 6,
          "destroy_affected_by_griefing": true,
          "fuse_length": 0
        }
      },
      "effect:default_crystal": {
        "minecraft:on_hurt": {
          "event": "minecraft:crystal_explode",
          "target": "self"
        }
      },
      "effect:spectral_rider": {
        "minecraft:type_family": {
          "family": [
            "ender_crystal",
            "spectral_sword",
            "effect99_entities"
          ]
        },
        "minecraft:scale": {
          "value": 0.55
        },
        "minecraft:collision_box": {
          "width": 0,
          "height": 0
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": "no"
            }
          ]
        }
      },
      "effect:ender_crystal_scale": {
        "minecraft:type_family": {
          "family": [
            "ender_crystal",
            "spectral_sword",
            "ender_crystal_scale",
            "effect99_entities"
          ]
        },
        "minecraft:scale": {
          "value": 0.2
        },
        "minecraft:collision_box": {
          "width": 0,
          "height": 0
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "cause": "all",
              "deals_damage": "no"
            }
          ]
        },
        "minecraft:timer": {
          "time": 18,
          "looping": false,
          "time_down_event": {
            "event": "effect:end_scale",
            "target": "self"
          }
        }
      },
      "effect:instant_despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "events": {
      "minecraft:crystal_explode": {
        "sequence": [
          {
            "filters": {
              "test": "is_family",
              "subject": "self",
              "operator": "!=",
              "value": "spectral_sword"
            },
            "queue_command": {
              "command": [
                "scriptevent effect:ender_crystal_exploded ~"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "crystal_exploding"
              ]
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "effect:default_crystal"
          ]
        }
      },
      "effect:spectral_rider": {
        "remove": {
          "component_groups": [
            "effect:default_crystal",
            "effect:ender_crystal_scale"
          ]
        },
        "add": {
          "component_groups": [
            "effect:spectral_rider"
          ]
        }
      },
      "effect:end_scale": {
        "remove": {
          "component_groups": [
            "effect:default_crystal",
            "effect:ender_crystal_scale"
          ]
        },
        "add": {
          "component_groups": [
            "effect:spectral_rider"
          ]
        },
        "queue_command": {
          "command": [
            "playsound portal.travel @a[r=16] ~ ~ ~ 0.6 7",
            "particle minecraft:example_flipbook ~ ~0.8 ~"
          ]
        }
      },
      "effect:ender_crystal_scale": {
        "remove": {
          "component_groups": [
            "effect:default_crystal",
            "effect:spectral_rider"
          ]
        },
        "add": {
          "component_groups": [
            "effect:ender_crystal_scale"
          ]
        }
      },
      "effect:despawn": {
        "add": {
          "component_groups": [
            "effect:instant_despawn"
          ]
        }
      }
    }
  }
}
