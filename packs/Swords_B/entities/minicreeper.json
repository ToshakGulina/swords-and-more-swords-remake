{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:minicreeper",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "projectile": {
        "minecraft:projectile": {
          "on_hit": {
            "definition_event": {
              "affect_projectile": true,
              "event_trigger": {
                "event": "minecraft:stop_projectile",
                "target": "self"
              }
            },
            "impact_damage": {
              "damage": 1,
              "knockback": true
            }
          },
          "power": 1,
          "gravity": 0.02,
          "inertia": 1,
          "liquid_inertia": 1
        }
      },
      "minicreeper": {
        "minecraft:timer": {
          "time": [
            10,
            10
          ],
          "looping": true,
          "randomInterval": false,
          "time_down_event": {
            "event": "start_minicreeper_exploding",
            "target": "self"
          }
        },
        "minecraft:scale": {
          "value": 0.3
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              },
              "max_dist": 16
            }
          ],
          "must_see": true,
          "must_see_forget_duration": 0
        },
        "minecraft:type_family": {
          "family": [
            "creeper",
            "player",
            "mob",
            "effect99_entities"
          ]
        },
        "minecraft:target_nearby_sensor": {
          "inside_range": 2.5,
          "must_see": true,
          "on_inside_range": {
            "event": "start_minicreeper_exploding",
            "target": "self"
          }
        },
        "minecraft:damage_sensor": {
          "triggers": {
            "on_damage": {
              "filters": {
                "any_of": [
                  {
                    "test": "has_damage",
                    "subject": "self",
                    "operator": "!=",
                    "value": "void"
                  }
                ]
              },
              "event": "start_minicreeper_exploding"
            },
            "deals_damage": true
          }
        }
      },
      "exploding": {
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "all",
            "deals_damage": false
          }
        },
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 1,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "despawn": {
        "minecraft:despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "creeper",
          "player",
          "mob",
          "effect99_entities"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.3,
        "height": 0.6
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.32
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },
    "events": {
      "effect:minicreeper_projectile": {
        "add": {
          "component_groups": [
            "projectile",
            "minicreeper"
          ]
        }
      },
      "minecraft:stop_projectile": {
        "remove": {
          "component_groups": [
            "projectile"
          ]
        },
        "add": {
          "component_groups": [
            "minicreeper"
          ]
        }
      },
      "start_minicreeper_exploding": {
        "add": {
          "component_groups": [
            "exploding"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "projectile",
            "minicreeper"
          ]
        }
      },
      "effect:instant_despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      }
    }
  }
}
