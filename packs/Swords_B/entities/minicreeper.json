{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "entity:minicreeper",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "exploding": {
        "minecraft:explode": {
          "fuse_length": 1.2,
          "fuse_lit": true,
          "power": 1.5,
          "causes_fire": false,
          "destroy_affected_by_griefing": true
        }
      },
      "despawn": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "creeper",
          "player",
          "effect99_entities"
        ]
      },
      "minecraft:scale": {
        "value": 0.35
      },
      "minecraft:collision_box": {
        "width": 0.3,
        "height": 0.6
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.32
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:behavior.melee_attack": {
        "priority": 2,
        "speed_multiplier": 1.25,
        "track_target": true
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "within_radius": 16,
        "must_see": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "monster"
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:target_nearby_sensor": {
        "inside_range": 2.5,
        "must_see": true,
        "on_inside_range": {
          "event": "start_exploding",
          "target": "self"
        }
      },
      "minecraft:timer": {
        "time": [
          6,
          8
        ],
        "looping": false,
        "time_down_event": {
          "event": "start_exploding",
          "target": "self"
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              }
            },
            "deals_damage": false
          }
        ]
      }
    },
    "events": {
      "start_exploding": {
        "add": {
          "component_groups": [
            "exploding"
          ]
        }
      },
      "despawn": {
        "add": {
          "component_groups": [
            "despawn"
          ]
        }
      }
    }
  }
}
